-- ============================================================
-- SMV Model (Auto-generated from PML - DCCP)
-- ============================================================

MODULE main

VAR
  turn :  {P_Network, P_DCCP_AtoN, P_DCCP_BtoN};

  AtoN : {EMPTY, DCCP_REQUEST, DCCP_RESPONSE, DCCP_DATA, DCCP_ACK, DCCP_DATAACK, DCCP_CLOSEREQ, DCCP_CLOSE, DCCP_RESET, DCCP_SYNC, DCCP_SYNCACK};
  NtoA : {EMPTY, DCCP_REQUEST, DCCP_RESPONSE, DCCP_DATA, DCCP_ACK, DCCP_DATAACK, DCCP_CLOSEREQ, DCCP_CLOSE, DCCP_RESET, DCCP_SYNC, DCCP_SYNCACK};
  BtoN : {EMPTY, DCCP_REQUEST, DCCP_RESPONSE, DCCP_DATA, DCCP_ACK, DCCP_DATAACK, DCCP_CLOSEREQ, DCCP_CLOSE, DCCP_RESET, DCCP_SYNC, DCCP_SYNCACK};
  NtoB : {EMPTY, DCCP_REQUEST, DCCP_RESPONSE, DCCP_DATA, DCCP_ACK, DCCP_DATAACK, DCCP_CLOSEREQ, DCCP_CLOSE, DCCP_RESET, DCCP_SYNC, DCCP_SYNCACK};

  state_0 : {0, CloseReqState, ClosedState, ClosingState, ListenState, OpenState, PartOpenState, RequestState, RespondState, TimeWaitState};
  state_1 : {0, CloseReqState, ClosedState, ClosingState, ListenState, OpenState, PartOpenState, RequestState, RespondState, TimeWaitState};
  before_state_0 : {0, CloseReqState, ClosedState, ClosingState, ListenState, OpenState, PartOpenState, RequestState, RespondState, TimeWaitState};
  before_state_1 : {0, CloseReqState, ClosedState, ClosingState, ListenState, OpenState, PartOpenState, RequestState, RespondState, TimeWaitState};

  Network_s : {__init_Network, _DUMMY};
  DCCP_AtoN_s : {CLOSED, LISTEN, REQUEST, RESPOND, PARTOPEN, OPEN, CLOSEREQ, CLOSING, TIMEWAIT};
  DCCP_AtoN_I_am_active : boolean;
  DCCP_AtoN_i :  {0, 1};
  DCCP_BtoN_s : {CLOSED, LISTEN, REQUEST, RESPOND, PARTOPEN, OPEN, CLOSEREQ, CLOSING, TIMEWAIT};
  DCCP_BtoN_I_am_active : boolean;
  DCCP_BtoN_i :  {0, 1};

ASSIGN
  init(turn) := {P_Network, P_DCCP_AtoN, P_DCCP_BtoN};
  init(AtoN) := EMPTY;
  init(NtoA) := EMPTY;
  init(BtoN) := EMPTY;
  init(NtoB) := EMPTY;
  init(state_0) := 0;
  init(state_1) := 0;
  init(before_state_0) := 0;
  init(before_state_1) := 0;
  init(Network_s) := __init_Network;
  init(DCCP_AtoN_s) := CLOSED;
  init(DCCP_AtoN_I_am_active) := FALSE;
  init(DCCP_AtoN_i) := 0;
  init(DCCP_BtoN_s) := CLOSED;
  init(DCCP_BtoN_I_am_active) := FALSE;
  init(DCCP_BtoN_i) := 1;

  next(turn) := {P_Network, P_DCCP_AtoN, P_DCCP_BtoN};

  -- Network state
  next(Network_s) := case
    turn != P_Network :  Network_s;
    Network_s = __init_Network & AtoN = DCCP_ACK & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_CLOSE & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_CLOSEREQ & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_DATA & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_DATAACK & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_REQUEST & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_RESET & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_RESPONSE & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_SYNC & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & AtoN = DCCP_SYNCACK & NtoB = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_ACK & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_CLOSE & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_CLOSEREQ & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_DATA & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_DATAACK & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_REQUEST & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_RESET & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_RESPONSE & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_SYNC & NtoA = EMPTY :  __init_Network;
    Network_s = __init_Network & BtoN = DCCP_SYNCACK & NtoA = EMPTY :  __init_Network;
    TRUE :  Network_s;
  esac;

  -- DCCP_AtoN state
  next(DCCP_AtoN_s) := case
    turn != P_DCCP_AtoN :  DCCP_AtoN_s;
    DCCP_AtoN_s = CLOSED & AtoN = EMPTY :  {LISTEN, REQUEST};
    DCCP_AtoN_s = CLOSED : LISTEN;
    DCCP_AtoN_s = LISTEN & NtoA = DCCP_REQUEST & AtoN = EMPTY :  RESPOND;
    DCCP_AtoN_s = LISTEN : CLOSED;
    DCCP_AtoN_s = REQUEST & NtoA = DCCP_RESPONSE & AtoN = EMPTY :  PARTOPEN;
    DCCP_AtoN_s = REQUEST & NtoA = DCCP_SYNC & AtoN = EMPTY :  CLOSED;
    DCCP_AtoN_s = REQUEST & NtoA = DCCP_RESET :  CLOSED;
    DCCP_AtoN_s = REQUEST : CLOSED;
    DCCP_AtoN_s = RESPOND & AtoN = EMPTY :  RESPOND;
    DCCP_AtoN_s = RESPOND & NtoA = DCCP_ACK :  OPEN;
    DCCP_AtoN_s = RESPOND & NtoA = DCCP_DATAACK :  OPEN;
    DCCP_AtoN_s = RESPOND : CLOSED;
    DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_CLOSE & AtoN = EMPTY :  CLOSED;
    DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_CLOSEREQ & AtoN = EMPTY :  CLOSING;
    DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_DATA & AtoN = EMPTY :  OPEN;
    DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_DATAACK & AtoN = EMPTY :  OPEN;
    DCCP_AtoN_s = PARTOPEN & AtoN = EMPTY :  PARTOPEN;
    DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_ACK :  OPEN;
    DCCP_AtoN_s = PARTOPEN : CLOSED;
    DCCP_AtoN_s = OPEN & AtoN = EMPTY & DCCP_AtoN_I_am_active = TRUE :  {CLOSED, CLOSEREQ, CLOSING};
    DCCP_AtoN_s = OPEN & NtoA = DCCP_CLOSE & AtoN = EMPTY :  CLOSED;
    DCCP_AtoN_s = OPEN & NtoA = DCCP_CLOSEREQ & AtoN = EMPTY :  {CLOSED, CLOSING};
    DCCP_AtoN_s = OPEN & AtoN = EMPTY :  {CLOSED, OPEN};
    DCCP_AtoN_s = OPEN & NtoA = DCCP_ACK :  {CLOSED, OPEN};
    DCCP_AtoN_s = OPEN & NtoA = DCCP_DATA :  {CLOSED, OPEN};
    DCCP_AtoN_s = OPEN & NtoA = DCCP_DATAACK :  {CLOSED, OPEN};
    DCCP_AtoN_s = OPEN : CLOSED;
    DCCP_AtoN_s = CLOSEREQ & NtoA = DCCP_CLOSE & AtoN = EMPTY :  CLOSED;
    DCCP_AtoN_s = CLOSING & NtoA = DCCP_RESET :  TIMEWAIT;
    DCCP_AtoN_s = CLOSING : CLOSED;
    DCCP_AtoN_s = TIMEWAIT : CLOSED;
    TRUE :  DCCP_AtoN_s;
  esac;

  -- DCCP_AtoN_I_am_active
  next(DCCP_AtoN_I_am_active) := case
    turn != P_DCCP_AtoN :  DCCP_AtoN_I_am_active;
    DCCP_AtoN_s = CLOSED & AtoN = EMPTY : TRUE;
    DCCP_AtoN_s = CLOSEREQ & NtoA = DCCP_CLOSE & AtoN = EMPTY : FALSE;
    DCCP_AtoN_s = CLOSING :  FALSE;
    DCCP_AtoN_s = LISTEN & NtoA = DCCP_REQUEST & AtoN = EMPTY : FALSE;
    DCCP_AtoN_s = LISTEN :  FALSE;
    DCCP_AtoN_s = OPEN & NtoA = DCCP_CLOSE & AtoN = EMPTY : FALSE;
    DCCP_AtoN_s = OPEN :  FALSE;
    DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_CLOSE & AtoN = EMPTY : FALSE;
    DCCP_AtoN_s = PARTOPEN :  FALSE;
    DCCP_AtoN_s = REQUEST & NtoA = DCCP_SYNC & AtoN = EMPTY : FALSE;
    DCCP_AtoN_s = REQUEST & NtoA = DCCP_RESET : FALSE;
    DCCP_AtoN_s = REQUEST :  FALSE;
    DCCP_AtoN_s = RESPOND & AtoN = EMPTY : FALSE;
    DCCP_AtoN_s = RESPOND :  FALSE;
    DCCP_AtoN_s = TIMEWAIT :  FALSE;
    TRUE : DCCP_AtoN_I_am_active;
  esac;

  -- DCCP_BtoN state
  next(DCCP_BtoN_s) := case
    turn != P_DCCP_BtoN :  DCCP_BtoN_s;
    DCCP_BtoN_s = CLOSED & BtoN = EMPTY :  {LISTEN, REQUEST};
    DCCP_BtoN_s = CLOSED : LISTEN;
    DCCP_BtoN_s = LISTEN & NtoB = DCCP_REQUEST & BtoN = EMPTY :  RESPOND;
    DCCP_BtoN_s = LISTEN : CLOSED;
    DCCP_BtoN_s = REQUEST & NtoB = DCCP_RESPONSE & BtoN = EMPTY :  PARTOPEN;
    DCCP_BtoN_s = REQUEST & NtoB = DCCP_SYNC & BtoN = EMPTY :  CLOSED;
    DCCP_BtoN_s = REQUEST & NtoB = DCCP_RESET :  CLOSED;
    DCCP_BtoN_s = REQUEST : CLOSED;
    DCCP_BtoN_s = RESPOND & BtoN = EMPTY :  RESPOND;
    DCCP_BtoN_s = RESPOND & NtoB = DCCP_ACK :  OPEN;
    DCCP_BtoN_s = RESPOND & NtoB = DCCP_DATAACK :  OPEN;
    DCCP_BtoN_s = RESPOND : CLOSED;
    DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_CLOSE & BtoN = EMPTY :  CLOSED;
    DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_CLOSEREQ & BtoN = EMPTY :  CLOSING;
    DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_DATA & BtoN = EMPTY :  OPEN;
    DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_DATAACK & BtoN = EMPTY :  OPEN;
    DCCP_BtoN_s = PARTOPEN & BtoN = EMPTY :  PARTOPEN;
    DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_ACK :  OPEN;
    DCCP_BtoN_s = PARTOPEN : CLOSED;
    DCCP_BtoN_s = OPEN & BtoN = EMPTY & DCCP_BtoN_I_am_active = TRUE :  {CLOSED, CLOSEREQ, CLOSING};
    DCCP_BtoN_s = OPEN & NtoB = DCCP_CLOSE & BtoN = EMPTY :  CLOSED;
    DCCP_BtoN_s = OPEN & NtoB = DCCP_CLOSEREQ & BtoN = EMPTY :  {CLOSED, CLOSING};
    DCCP_BtoN_s = OPEN & BtoN = EMPTY :  {CLOSED, OPEN};
    DCCP_BtoN_s = OPEN & NtoB = DCCP_ACK :  {CLOSED, OPEN};
    DCCP_BtoN_s = OPEN & NtoB = DCCP_DATA :  {CLOSED, OPEN};
    DCCP_BtoN_s = OPEN & NtoB = DCCP_DATAACK :  {CLOSED, OPEN};
    DCCP_BtoN_s = OPEN : CLOSED;
    DCCP_BtoN_s = CLOSEREQ & NtoB = DCCP_CLOSE & BtoN = EMPTY :  CLOSED;
    DCCP_BtoN_s = CLOSING & NtoB = DCCP_RESET :  TIMEWAIT;
    DCCP_BtoN_s = CLOSING : CLOSED;
    DCCP_BtoN_s = TIMEWAIT : CLOSED;
    TRUE :  DCCP_BtoN_s;
  esac;

  -- DCCP_BtoN_I_am_active
  next(DCCP_BtoN_I_am_active) := case
    turn != P_DCCP_BtoN :  DCCP_BtoN_I_am_active;
    DCCP_BtoN_s = CLOSED & BtoN = EMPTY : TRUE;
    DCCP_BtoN_s = CLOSEREQ & NtoB = DCCP_CLOSE & BtoN = EMPTY : FALSE;
    DCCP_BtoN_s = CLOSING :  FALSE;
    DCCP_BtoN_s = LISTEN & NtoB = DCCP_REQUEST & BtoN = EMPTY : FALSE;
    DCCP_BtoN_s = LISTEN :  FALSE;
    DCCP_BtoN_s = OPEN & NtoB = DCCP_CLOSE & BtoN = EMPTY : FALSE;
    DCCP_BtoN_s = OPEN :  FALSE;
    DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_CLOSE & BtoN = EMPTY : FALSE;
    DCCP_BtoN_s = PARTOPEN :  FALSE;
    DCCP_BtoN_s = REQUEST & NtoB = DCCP_SYNC & BtoN = EMPTY : FALSE;
    DCCP_BtoN_s = REQUEST & NtoB = DCCP_RESET : FALSE;
    DCCP_BtoN_s = REQUEST :  FALSE;
    DCCP_BtoN_s = RESPOND & BtoN = EMPTY : FALSE;
    DCCP_BtoN_s = RESPOND :  FALSE;
    DCCP_BtoN_s = TIMEWAIT :  FALSE;
    TRUE : DCCP_BtoN_I_am_active;
  esac;

  -- state_0
  next(state_0) := case
    turn = P_DCCP_AtoN & DCCP_AtoN_s = LISTEN :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST & NtoA = DCCP_RESET : ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST & NtoA = DCCP_SYNC & AtoN = EMPTY : ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = RESPOND & AtoN = EMPTY : ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = RESPOND :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_CLOSE & AtoN = EMPTY : ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & NtoA = DCCP_CLOSE & AtoN = EMPTY : ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = CLOSEREQ & NtoA = DCCP_CLOSE & AtoN = EMPTY : ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = CLOSING :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = TIMEWAIT :  ClosedState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = CLOSED :  ListenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = CLOSED & AtoN = EMPTY : RequestState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = LISTEN & NtoA = DCCP_REQUEST & AtoN = EMPTY : RespondState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = RESPOND & AtoN = EMPTY : RespondState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST & NtoA = DCCP_RESPONSE & AtoN = EMPTY : PartOpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN & AtoN = EMPTY : PartOpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = RESPOND & NtoA = DCCP_ACK : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = RESPOND & NtoA = DCCP_DATAACK : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_DATA & AtoN = EMPTY : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_DATAACK & AtoN = EMPTY : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_ACK : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & AtoN = EMPTY : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & AtoN = EMPTY : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & NtoA = DCCP_ACK : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & NtoA = DCCP_DATA : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & NtoA = DCCP_DATAACK : OpenState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & AtoN = EMPTY & DCCP_AtoN_I_am_active = TRUE : CloseReqState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = PARTOPEN & NtoA = DCCP_CLOSEREQ & AtoN = EMPTY : ClosingState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & AtoN = EMPTY & DCCP_AtoN_I_am_active = TRUE : ClosingState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = OPEN & NtoA = DCCP_CLOSEREQ & AtoN = EMPTY : ClosingState;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = CLOSING & NtoA = DCCP_RESET : TimeWaitState;
    TRUE : state_0;
  esac;

  -- state_1
  next(state_1) := case
    turn = P_DCCP_BtoN & DCCP_BtoN_s = LISTEN :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = REQUEST & NtoB = DCCP_RESET : ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = REQUEST & NtoB = DCCP_SYNC & BtoN = EMPTY : ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = REQUEST :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = RESPOND & BtoN = EMPTY : ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = RESPOND :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_CLOSE & BtoN = EMPTY : ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & NtoB = DCCP_CLOSE & BtoN = EMPTY : ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSEREQ & NtoB = DCCP_CLOSE & BtoN = EMPTY : ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSING :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = TIMEWAIT :  ClosedState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSED :  ListenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSED & BtoN = EMPTY : RequestState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = LISTEN & NtoB = DCCP_REQUEST & BtoN = EMPTY : RespondState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = RESPOND & BtoN = EMPTY : RespondState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = REQUEST & NtoB = DCCP_RESPONSE & BtoN = EMPTY : PartOpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN & BtoN = EMPTY : PartOpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = RESPOND & NtoB = DCCP_ACK : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = RESPOND & NtoB = DCCP_DATAACK : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_DATA & BtoN = EMPTY : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_DATAACK & BtoN = EMPTY : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_ACK : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & BtoN = EMPTY : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & BtoN = EMPTY : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & NtoB = DCCP_ACK : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & NtoB = DCCP_DATA : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & NtoB = DCCP_DATAACK : OpenState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & BtoN = EMPTY & DCCP_BtoN_I_am_active = TRUE : CloseReqState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = PARTOPEN & NtoB = DCCP_CLOSEREQ & BtoN = EMPTY : ClosingState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & BtoN = EMPTY & DCCP_BtoN_I_am_active = TRUE : ClosingState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & NtoB = DCCP_CLOSEREQ & BtoN = EMPTY : ClosingState;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSING & NtoB = DCCP_RESET : TimeWaitState;
    TRUE : state_1;
  esac;

  -- before_state_0
  next(before_state_0) := case
    turn = P_DCCP_AtoN & DCCP_AtoN_s = LISTEN :  state_0;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST & NtoA = DCCP_RESET : state_0;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST & NtoA = DCCP_SYNC & AtoN = EMPTY : state_0;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = REQUEST :  state_0;
    turn = P_DCCP_AtoN & DCCP_AtoN_s = RESPOND & AtoN = EMPTY : state_0;
