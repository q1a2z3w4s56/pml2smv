    turn = P_DCCP_BtoN & DCCP_BtoN_s = OPEN & NtoB = DCCP_CLOSEREQ & BtoN = EMPTY :  EMPTY;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSEREQ & NtoB = DCCP_CLOSE & BtoN = EMPTY :  EMPTY;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = CLOSING & NtoB = DCCP_RESET :  EMPTY;
    TRUE :  NtoB;
  esac;

-- Fairness constraints
FAIRNESS turn = P_Network
FAIRNESS turn = P_DCCP_AtoN
FAIRNESS turn = P_DCCP_BtoN

-- ============================================================
-- Properties
-- ============================================================

-- CTL Properties
CTLSPEC EF (DCCP_AtoN_s = OPEN & DCCP_BtoN_s = OPEN)
CTLSPEC EF (DCCP_AtoN_s = OPEN)
CTLSPEC EF (DCCP_BtoN_s = OPEN)
CTLSPEC AG (DCCP_AtoN_s = CLOSEREQ -> DCCP_AtoN_I_am_active = TRUE)
CTLSPEC AG (DCCP_BtoN_s = CLOSEREQ -> DCCP_BtoN_I_am_active = TRUE)
