  next(NtoB) := case
    turn = P_Network & Network_s = __init_Network & NtoB = EMPTY & AtoN = DCCP_REQUEST : DCCP_REQUEST;
    turn = P_Network & Network_s = __init_Network & NtoB = EMPTY & AtoN = DCCP_RESPONSE : DCCP_RESPONSE;
    turn = P_Network & Network_s = __init_Network & NtoB = EMPTY & AtoN = DCCP_DATA : DCCP_DATA;
