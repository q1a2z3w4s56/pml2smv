    turn = P_DCCP_BtoN & DCCP_BtoN_s = LISTEN & NtoB = DCCP_REQUEST & BtoN = EMPTY :  EMPTY;
    turn = P_DCCP_BtoN & DCCP_BtoN_s = REQUEST & NtoB = DCCP_RESPONSE & BtoN = EMPTY :  EMPTY;
